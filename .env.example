# TheClosedTest — Mobile App environment
# Copy to .env and fill in values. Never commit real secrets.

# Backend API base URL (defaults to production if unset)
EXPO_PUBLIC_API_URL=

# Local backend URL used by the dev-only API switch in Settings
EXPO_PUBLIC_LOCAL_API_URL=http://192.168.1.4:9000

# Set to "true" to boot straight into the local server in dev builds
EXPO_PUBLIC_DEFAULT_TO_LOCAL_API=false

# Clerk authentication
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=

# AdMob (Android test IDs are used automatically in dev builds)
EXPO_PUBLIC_ADMOB_REWARDED_UNIT_ID=
