{
  "name": "theclosedtest-backend",
  "version": "3.0.0",
  "description": "High-performance REST API backend for TheClosedTest built with Hono, Drizzle ORM, and Bun",
  "keywords": [
    "Bun",
    "Drizzle",
    "Hono",
    "OpenAPI",
    "PostgreSQL",
    "TheClosedTest",
    "Typescript"
  ],
  "license": "SEE LICENSE IN ../LICENSE",
  "author": "TheClosedTest Contributors",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "bun --hot src/index.ts",
    "build": "bun build src/index.ts --outdir dist --target bun",
    "start": "bun dist/index.js",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt ./src",
    "format:check": "oxfmt --check ./src",
    "check": "oxlint && oxfmt --check ./src",
    "check:fix": "oxlint --fix && oxfmt ./src",
    "type-check": "tsc --pretty --noEmit",
    "prepare": "husky",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1114.0",
    "@aws-sdk/s3-request-presigner": "^3.1114.0",
    "@clerk/backend": "^3.16.10",
    "@hono/zod-openapi": "^1.6.1",
    "@scalar/hono-api-reference": "^0.11.14",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.13.2",
    "hono-pino": "^0.10.3",
    "jose": "^6.2.10",
    "pino": "^10.3.1",
    "postgres": "^3.4.9",
    "stoker": "^2.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.5",
    "@types/bun": "^1.3.14",
    "drizzle-kit": "^0.31.10",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "oxfmt": "^0.63.0",
    "oxlint": "^1.78.0",
    "pino-pretty": "^13.1.3",
    "typescript": "^7.0.2"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "oxlint --fix",
      "oxfmt"
    ]
  },
  "volta": {
    "node": "24.12.0"
  }
}
