{
  "expo": {
    "name": "theclosedtest",
    "slug": "theclosedtest",
    "version": "3.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "theclosedtest",
    "userInterfaceStyle": "automatic",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/5ef1829f-e48b-4b44-ace2-2e4fd488e2c7"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon/adaptive-icon.png",
        "backgroundColor": "#3B82F6"
      },
      "package": "com.theneerajsec.theclosedtest",
      "googleServicesFile": "./google-services.json",
      "softwareKeyboardLayoutMode": "resize"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "./plugins/withDisableLint.js",
      "expo-router",
      "expo-secure-store",
      "expo-web-browser",
      "expo-image",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/adaptive-icon/adaptive-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#3B82F6"
        }
      ],
      "expo-status-bar",
      [
        "expo-build-properties",
        {
          "android": {
            "newArchEnabled": true,
            "enableShrinking": false,
            "enableProguardInReleaseBuilds": false,
            "extraProguardRules": "-dontwarn **\n-keep class com.google.android.gms.ads.** { *; }\n-keep class coil3.** { *; }",
            "packagingOptions": {
              "pickFirst": ["**/libc++_shared.so"]
            }
          }
        }
      ],
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-3238435978294704~7120634978",
          "iosAppId": "ca-app-pub-3940256099942544~1458002511"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "5ef1829f-e48b-4b44-ace2-2e4fd488e2c7"
      }
    }
  }
}
